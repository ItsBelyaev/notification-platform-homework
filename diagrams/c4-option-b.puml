@startuml
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Вариант B — durable workflow на Temporal
LAYOUT_LEFT_RIGHT()

System_Ext(source, "Банковские системы", "Создают уведомления и читают статус")
System_Ext(profile, "Profile / Preference System", "Контакты и настройки")
System_Ext(pushProvider, "Push Provider", "APNs / FCM")
System_Ext(smsProvider, "SMS Provider", "SMS доставка")
System_Ext(emailProvider, "Email Provider", "Email доставка")
System_Ext(mobile, "Мобильное приложение", "App acknowledgement")

System_Boundary(platform, "Notification Platform") {
  Container(api, "Notification API", "Java, Spring Boot", "Проверяет запрос и запускает workflow")
  ContainerDb(registry, "Idempotency Registry", "PostgreSQL", "Связывает source key с notification/workflow ID")
  Container(temporal, "Temporal Cluster", "Temporal Server", "Durable workflows, timers, signals, retries и task queues")
  ContainerDb(temporalDb, "Temporal Persistence", "PostgreSQL", "Workflow history и durable timers")
  Container(visibility, "Workflow Visibility", "OpenSearch", "Поиск workflow и operational UI")
  Container(workers, "Delivery Workflow Workers", "Java + Temporal SDK", "Workflow-код и Activities push/SMS/email")
  Container(preferences, "Preference Adapter", "Java + Redis Cluster", "Контакты и настройки")
  Container(templates, "Template Service", "Java, Spring Boot", "Рендер сообщений")
  Container(callback, "Callback Gateway", "Java, Spring Boot", "Преобразует callbacks в Temporal Signals")
  Container(audit, "Audit / Analytics", "ClickHouse + S3", "Бизнес-аудит, метрики и архив")
}

Rel(source, api, "Создаёт уведомление / читает статус", "HTTPS/JSON")
Rel(api, registry, "Проверяет idempotency key", "JDBC")
Rel(api, temporal, "StartWorkflow / QueryWorkflow", "gRPC")
Rel(temporal, temporalDb, "Хранит history и timers")
Rel(temporal, visibility, "Индексирует workflow")
Rel(workers, temporal, "Получает workflow/activity tasks", "gRPC")
Rel(workers, preferences, "Activity: получить route")
Rel(preferences, profile, "Читает источник истины", "HTTPS")
Rel(workers, templates, "Activity: render", "gRPC")
Rel(workers, pushProvider, "Push Activity", "HTTPS")
Rel(workers, smsProvider, "SMS Activity", "HTTPS")
Rel(workers, emailProvider, "Email Activity", "HTTPS")
Rel(pushProvider, mobile, "Доставляет push")
Rel(mobile, callback, "App acknowledgement", "HTTPS")
Rel(pushProvider, callback, "Provider callback", "HTTPS")
Rel(smsProvider, callback, "Delivery receipt", "HTTPS")
Rel(emailProvider, callback, "Delivered callback", "HTTPS")
Rel(callback, temporal, "SignalWorkflow(notification ID)", "gRPC")
Rel(workers, audit, "Экспортирует business events")

SHOW_LEGEND()
@enduml
